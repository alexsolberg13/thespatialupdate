<div class="stat-grid">
  <div class="stat-card">
    <div class="stat-value">~1,300 km</div>
    <div class="stat-label">Angola rail rehabbed to the Atlantic</div>
  </div>
  <div class="stat-card">
    <div class="stat-value">10×</div>
    <div class="stat-label">targeted capacity rise, to 4.6 Mt/yr</div>
  </div>
  <div class="stat-card">
    <div class="stat-value">~72%</div>
    <div class="stat-label">of world cobalt mined in the DRC (2025)</div>
  </div>
  <div class="stat-card">
    <div class="stat-value">$1.4bn</div>
    <div class="stat-label">China's competing TAZARA revamp</div>
  </div>
</div>

<div class="section-block">
  <div class="section-label">Map layers</div>
  <label class="layer-toggle">
    <input type="checkbox" id="toggle-lobito" checked />
    <div class="layer-swatch" style="background:#e8c87a"></div>
    Lobito Corridor (+ planned extension)
  </label>
  <label class="layer-toggle">
    <input type="checkbox" id="toggle-tazara" checked />
    <div class="layer-swatch" style="background:#5b9bd5"></div>
    TAZARA + Copperbelt feeder (east)
  </label>
  <label class="layer-toggle">
    <input type="checkbox" id="toggle-ports" checked />
    <div class="layer-swatch" style="background:#3ecfb2; height:8px; width:8px; border-radius:50%; margin-right:2px;"></div>
    Ocean ports
  </label>
  <label class="layer-toggle">
    <input type="checkbox" id="toggle-mines" checked />
    <div class="layer-swatch" style="background:#e05a4e; height:8px; width:8px; border-radius:50%; margin-right:2px;"></div>
    Copperbelt hubs
  </label>
</div>
