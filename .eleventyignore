# Claim ledgers (sources.html) are kept in the repo for Harvey's own reference,
# but are deliberately NOT published to the live site. Eleventy skips them here,
# so no /stories/<slug>/sources/ page is ever built or served. Open the raw
# src/stories/<slug>/sources.html file locally to read a ledger.
src/stories/*/sources.html

# Story Beat Reels are copied straight through by .eleventy.js (not built as
# templates). Their narration scripts (src/reels/<slug>-script.md) are not copied either;
# scripts/reel_scripts.js turns each into a page on the studio (claim IDs and notes hidden).
src/reels/

# Instagram slide posts (src/posts/<slug>/): built by scripts/posts_index.js after the
# Eleventy build, not by Eleventy. Slide data and slide text are working files.
src/posts/

# Studio home page template (src/studio/index.html): built by scripts/studio_index.js after the
# Eleventy build, from the reels and posts that exist.
src/studio/
